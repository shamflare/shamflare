# Shamflare — production environment for docker-compose.yml.
# Copy to .env on the server and replace every placeholder. Never commit .env.

# --- Public site -------------------------------------------------------------
# Domain served by Caddy (DNS A/AAAA records must point at the VPS).
SITE_DOMAIN=shamflare.com
# Contact address for Let's Encrypt certificate notices.
ACME_EMAIL=admin@example.com

# --- PostgreSQL (private; never published to the internet) -------------------
POSTGRES_DB=shamflare
POSTGRES_USER=shamflare
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=replace-with-a-long-random-password

# --- Django (see backend/.env.example for every option) -----------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=0
DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_PRELOAD=0
INQUIRY_THROTTLE_RATE=5/hour
LOGIN_THROTTLE_RATE=10/hour
MAX_UPLOAD_MB=5
GUNICORN_WORKERS=3

# --- Email notifications (prepared, inactive until configured) ---------------
# Leave INQUIRY_NOTIFICATION_EMAIL empty to keep notifications off. Inquiries are
# always stored in the database and visible in the dashboard either way.
INQUIRY_NOTIFICATION_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Shamflare <no-reply@shamflare.com>
DASHBOARD_BASE_URL=https://shamflare.com
