# Shamflare backend environment — PLACEHOLDERS ONLY. Copy to .env (dev) or
# inject via Docker/compose (prod). Never commit real values.

# --- Core -------------------------------------------------------------------
# Production refuses to start without a long random key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-value
# 1 only for local development (dev settings default to 1, prod forces 0)
DJANGO_DEBUG=0
# Comma-separated. Include the internal service name if other containers call
# the API directly (e.g. Next.js SSR -> http://backend:8000).
DJANGO_ALLOWED_HOSTS=shamflare.com,www.shamflare.com,backend
# Settings module: config.settings.dev | config.settings.prod (default for WSGI)
# DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------------
# PostgreSQL is the real target. Use a least-privilege role that owns only this DB.
DATABASE_URL=postgres://shamflare:change-me@db:5432/shamflare
# Local-only fallback (never in production):
# DATABASE_URL=sqlite:///db.sqlite3
DATABASE_CONN_MAX_AGE=60
DATABASE_CONNECT_TIMEOUT=5

# --- Cache (throttle counters) -------------------------------------------------
# prod defaults to the database cache (shared across gunicorn workers; the
# entrypoint runs createcachetable). Options: db | locmem
# DJANGO_CACHE_BACKEND=db

# --- Security / origins -------------------------------------------------------------
# Origins allowed to send unsafe requests with the session cookie.
CSRF_TRUSTED_ORIGINS=https://shamflare.com,https://www.shamflare.com
# Normally empty: the frontend and API share one origin. Never use "*".
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=0
# Trusted reverse proxies in front of Django (for client IP / X-Forwarded-For).
# 0 = ignore X-Forwarded-For (direct). Behind Caddy: 1.
NUM_PROXIES=1
# Caddy redirects HTTP->HTTPS; keep 0 so internal http calls are not redirected.
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=0
SESSION_COOKIE_AGE=43200
# Serve /api/v1/schema/ and /api/v1/docs/ publicly in production (default: staff only)
API_DOCS_PUBLIC=0

# --- Throttling ---------------------------------------------------------------
INQUIRY_THROTTLE_RATE=5/hour
LOGIN_THROTTLE_RATE=10/hour

# --- Files --------------------------------------------------------------------
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
MAX_UPLOAD_MB=5

# --- Email (prepared, NOT active) --------------------------------------------------
# Notifications for new inquiries are sent only when INQUIRY_NOTIFICATION_EMAIL
# is set. Fill the SMTP values of your provider first.
INQUIRY_NOTIFICATION_EMAIL=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Shamflare <no-reply@shamflare.com>
# Used for links in notification emails (e.g. https://shamflare.com)
DASHBOARD_BASE_URL=
# Receives Django error reports when email is configured (optional)
DJANGO_ADMIN_EMAIL=

# --- Container --------------------------------------------------------------------
DJANGO_RUN_MIGRATIONS=1
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30
