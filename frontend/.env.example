# Copy to .env.local for local development.

# Public origin used for canonical URLs, hreflang, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the Next.js server reaches Django. In Docker Compose: http://backend:8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Where uploaded media is fetched from by the image optimizer. Defaults to
# BACKEND_INTERNAL_URL (Django serves media when DEBUG=1). In Docker Compose: http://caddy:8080
MEDIA_INTERNAL_URL=
